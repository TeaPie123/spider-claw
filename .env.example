# 作用：提供本地或 Compose 部署所需的配置字段。
# 流程：复制为 .env → 填写真实凭证和项目目录 → 启动 API 与 Worker。
SYC_API_KEY=
SYC_MODEL_NAME=qwen-max
SYC_MODEL_PROVIDER=openai
SYC_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SYC_API_KEYS={"replace-with-client-key":"local"}
SYC_CLIENT_API_KEY=replace-with-client-key
SYC_TENANT_PROJECTS={"local":["default"]}
SYC_PROJECTS={"default":"/projects/default"}
SYC_PROJECTS_DIR=./projects
SYC_DATABASE_URL=postgresql://syc:change-me@postgres:5432/shanyang
SYC_PG_PASSWORD=change-me
SYC_REDIS_URL=redis://redis:6379/0
SYC_API_BASE_URL=http://localhost:18700
SYC_ARTIFACT_ROOT=./artifacts
SYC_SANDBOX_PROVIDER=docker
SYC_SANDBOX_IMAGE=spider-claw-sandbox:latest
SYC_SANDBOX_RUNTIME=runc
SYC_TASK_TIMEOUT=900
SYC_SANDBOX_POOL_SIZE=4
SYC_FEISHU_APP_ID=
SYC_FEISHU_APP_SECRET=
SYC_FEISHU_VERIFICATION_TOKEN=
SYC_FEISHU_TENANT_ID=local
SYC_FEISHU_PROJECT_ID=default
SYC_FEISHU_REPLY_ENABLED=false
SYC_LOG_LEVEL=INFO
SYC_LANGSMITH_TRACING=false
SYC_LANGSMITH_PROJECT=spider-claw
SYC_LANGSMITH_API_KEY=
